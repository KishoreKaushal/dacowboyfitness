{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "DaCowboy Fitness",
        "authorizedRedirectUris": [
          "http://localhost"
        ]
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
